<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>MyEverythingWidget.App</RootNamespace>
    <AssemblyName>MyEverythingWidget</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!--
    Development and test builds run unpackaged and self-contained, so the output folder runs on a clean
    Windows (for example Windows Sandbox) without installing a runtime or a certificate.
    Store builds pass -p:WindowsPackageType=MSIX (see scripts/publish-msix.ps1).
  -->
  <PropertyGroup Condition="'$(WindowsPackageType)' == ''">
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>
  <PropertyGroup>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyEverythingWidget.Core\MyEverythingWidget.Core.csproj" />
    <ProjectReference Include="..\MyEverythingWidget.Infrastructure\MyEverythingWidget.Infrastructure.csproj" />
    <ProjectReference Include="..\MyEverythingWidget.Presentation\MyEverythingWidget.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\*.png" />
    <Content Include="app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
