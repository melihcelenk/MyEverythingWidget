<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MyEverythingWidget.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:MyEverythingWidget.App.Localization"
    xmlns:local="using:MyEverythingWidget.App"
    xmlns:presentation="using:MyEverythingWidget.Presentation"
    xmlns:views="using:MyEverythingWidget.App.Views">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <!-- Right-click on an empty part of the grid or its surface: the same choices as the Add button. -->
            <MenuFlyout x:Key="SurfaceAddMenu">
                <MenuFlyoutItem AutomationProperties.AutomationId="GridAddAppMenuItem" Text="{l:Str Key=AddAppMenu}" Click="OnAddAppClicked">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xECAA;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem AutomationProperties.AutomationId="GridAddNoteMenuItem" Text="{l:Str Key=AddNote}" Click="OnAddNoteClicked">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE70B;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem AutomationProperties.AutomationId="GridAddImageMenuItem" Text="{l:Str Key=AddImageMenu}" Click="OnAddImageClicked">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xEB9F;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>

            <!-- Widget family slots around the compact icon (MEW-5); placed in MainWindow.Family.cs. -->
            <Style x:Key="FamilySlotButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="FamilySlotBorderStyle" TargetType="Border">
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="V" Invoked="OnPasteInvoked" />
        </Grid.KeyboardAccelerators>

        <!-- Expanded widget. Row heights are fixed so the window can be sized to whole cells (MainWindow.Sizing). -->
        <Grid x:Name="ExpandedView">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <!-- Behind the opaque surface: EmojiFontWarmUp draws the emojis here once, where they are never seen. -->
            <Grid x:Name="WarmUpLayer" Grid.Row="1" IsHitTestVisible="False" />

            <!-- Surface under the open tab; the tab strip stays on Mica. -->
            <Border Grid.Row="1"
                    Grid.RowSpan="3"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    ContextFlyout="{StaticResource SurfaceAddMenu}" />

            <!-- One-row title bar: pin, tabs, drag area, compact and close. -->
            <views:CategoryTabsView x:Name="TabsView" Grid.Row="0" Margin="4,0,4,0">
                <views:CategoryTabsView.LeadingContent>
                    <ToggleButton
                        x:Name="PinButton"
                        AutomationProperties.AutomationId="PinButton"
                        AutomationProperties.Name="{l:Str Key=AlwaysOnTop}"
                        ToolTipService.ToolTip="{l:Str Key=AlwaysOnTop}"
                        Style="{StaticResource TitleBarToggleButtonStyle}"
                        Margin="0,0,2,0"
                        IsChecked="{x:Bind ViewModel.IsAlwaysOnTop, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleAlwaysOnTopCommand}">
                        <FontIcon FontSize="14" Glyph="&#xE718;" />
                    </ToggleButton>
                </views:CategoryTabsView.LeadingContent>
                <views:CategoryTabsView.TrailingContent>
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="CompactButton"
                                AutomationProperties.AutomationId="CompactButton"
                                AutomationProperties.Name="{l:Str Key=CompactMode}"
                                ToolTipService.ToolTip="{l:Str Key=CompactModeTip}"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Command="{x:Bind ViewModel.ToggleCompactCommand}">
                            <FontIcon FontSize="12" Glyph="&#xE73F;" />
                        </Button>
                        <Button
                            x:Name="CloseButton"
                            AutomationProperties.AutomationId="CloseButton"
                            AutomationProperties.Name="{l:Str Key=Close}"
                            ToolTipService.ToolTip="{l:Str Key=Close}"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="OnCloseClicked">
                            <FontIcon FontSize="12" Glyph="&#xE8BB;" />
                        </Button>
                    </StackPanel>
                </views:CategoryTabsView.TrailingContent>
            </views:CategoryTabsView>

            <views:WidgetGridView
                x:Name="GridView"
                Grid.Row="1"
                AllowDrop="True"
                DragOver="OnGridDragOver"
                Drop="OnGridDrop"
                ContextFlyout="{StaticResource SurfaceAddMenu}"
                Margin="6,6,6,6"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" />

            <!-- Bottom bar: add items, settings. -->
            <Grid Grid.Row="3" Padding="8,4,4,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DropDownButton x:Name="AddItemButton"
                                AutomationProperties.AutomationId="AddItemButton"
                                AutomationProperties.Name="{l:Str Key=Add}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="{l:Str Key=Add}" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedLeft">
                            <MenuFlyoutItem x:Name="AddAppMenuItem"
                                            AutomationProperties.AutomationId="AddAppMenuItem"
                                            Text="{l:Str Key=AddMenuApp}"
                                            Click="OnAddAppClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xECAA;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="AddNoteMenuItem"
                                            AutomationProperties.AutomationId="AddNoteMenuItem"
                                            Text="{l:Str Key=AddMenuNote}"
                                            Click="OnAddNoteClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE70B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="AddImageMenuItem"
                                            AutomationProperties.AutomationId="AddImageMenuItem"
                                            Text="{l:Str Key=AddMenuImage}"
                                            Click="OnAddImageClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEB9F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"
                           Text="{l:Str Key=DropHint}" />
                <Button Grid.Column="2"
                        x:Name="SettingsButton"
                        AutomationProperties.AutomationId="SettingsButton"
                        AutomationProperties.Name="{l:Str Key=Settings}"
                        ToolTipService.ToolTip="{l:Str Key=Settings}"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Click="OnSettingsClicked">
                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                </Button>
            </Grid>

            <InfoBar
                x:Name="StatusBar"
                Grid.Row="2"
                Grid.RowSpan="2"
                Margin="8,0,8,8"
                VerticalAlignment="Bottom"
                AutomationProperties.AutomationId="StatusInfoBar"
                IsOpen="{x:Bind local:Bindings.HasText(Board.StatusMessage), Mode=OneWay}"
                Message="{x:Bind Board.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind local:Bindings.ToInfoBarSeverity(Board.StatusSeverity), Mode=OneWay}"
                CloseButtonCommand="{x:Bind Board.DismissStatusCommand}" />
        </Grid>

        <!-- Compact mode: the whole window is one icon. Click opens the widget; dragging moves the window. -->
        <Button x:Name="CompactIcon"
                AutomationProperties.AutomationId="CompactIcon"
                AutomationProperties.Name="{l:Str Key=OpenWidget}"
                ToolTipService.ToolTip="{l:Str Key=Open}"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Padding="0"
                CornerRadius="0"
                BorderThickness="0"
                Background="{ThemeResource SubtleFillColorTransparentBrush}"
                Click="OnCompactIconClicked"
                ContextRequested="OnCompactIconContextRequested">
            <Image x:Name="CompactLogo" AutomationProperties.AutomationId="CompactLogo" Width="48" Height="48" />
        </Button>

        <!--
          Widget family (MEW-5): right-click on the compact icon shows the installed family widgets on its four sides.
          The slots are placed in code (MainWindow.Family.cs) with the same rule the widgets use to place themselves,
          so a slot stays on the screen and sits on the side where its widget will open.
        -->
        <Popup x:Name="FamilyPopup"
               IsLightDismissEnabled="True"
               ShouldConstrainToRootBounds="False">
            <Canvas x:Name="FamilyRing" AutomationProperties.AutomationId="FamilyMenu">
                <Button x:Name="FamilyTop"
                        Style="{StaticResource FamilySlotButtonStyle}"
                        AutomationProperties.AutomationId="FamilySlot_Top"
                        AutomationProperties.Name="{x:Bind local:Bindings.SlotName(Family.Top), Mode=OneWay}"
                        Content="{x:Bind local:Bindings.SlotName(Family.Top), Mode=OneWay}"
                        Visibility="{x:Bind local:Bindings.VisibleWhenSlot(Family.Top), Mode=OneWay}"
                        Click="OnFamilySlotClicked" />
                <Button x:Name="FamilyRight"
                        Style="{StaticResource FamilySlotButtonStyle}"
                        AutomationProperties.AutomationId="FamilySlot_Right"
                        AutomationProperties.Name="{x:Bind local:Bindings.SlotName(Family.Right), Mode=OneWay}"
                        Content="{x:Bind local:Bindings.SlotName(Family.Right), Mode=OneWay}"
                        Visibility="{x:Bind local:Bindings.VisibleWhenSlot(Family.Right), Mode=OneWay}"
                        Click="OnFamilySlotClicked" />
                <Button x:Name="FamilyBottom"
                        Style="{StaticResource FamilySlotButtonStyle}"
                        AutomationProperties.AutomationId="FamilySlot_Bottom"
                        AutomationProperties.Name="{x:Bind local:Bindings.SlotName(Family.Bottom), Mode=OneWay}"
                        Content="{x:Bind local:Bindings.SlotName(Family.Bottom), Mode=OneWay}"
                        Visibility="{x:Bind local:Bindings.VisibleWhenSlot(Family.Bottom), Mode=OneWay}"
                        Click="OnFamilySlotClicked" />
                <Button x:Name="FamilyLeft"
                        Style="{StaticResource FamilySlotButtonStyle}"
                        AutomationProperties.AutomationId="FamilySlot_Left"
                        AutomationProperties.Name="{x:Bind local:Bindings.SlotName(Family.Left), Mode=OneWay}"
                        Content="{x:Bind local:Bindings.SlotName(Family.Left), Mode=OneWay}"
                        Visibility="{x:Bind local:Bindings.VisibleWhenSlot(Family.Left), Mode=OneWay}"
                        Click="OnFamilySlotClicked" />
                <!-- The notice that no other family widget is installed, with a download button for each published one. -->
                <Border x:Name="FamilyEmptyCard"
                        Style="{StaticResource FamilySlotBorderStyle}"
                        MaxWidth="240"
                        Visibility="{x:Bind local:Bindings.VisibleWhenAny(Family.ShowsNotice, Family.Downloads), Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="FamilyEmpty"
                                   AutomationProperties.AutomationId="FamilyEmpty"
                                   Text="{l:Str Key=FamilyEmpty}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind local:Bindings.VisibleWhen(Family.ShowsNotice), Mode=OneWay}" />
                        <ItemsControl ItemsSource="{x:Bind Family.Downloads, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="presentation:FamilyOffer">
                                    <Button Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,0,4"
                                            Tag="{x:Bind MemberId}"
                                            AutomationProperties.AutomationId="{x:Bind local:Bindings.DownloadId(MemberId)}"
                                            AutomationProperties.Name="{x:Bind local:Bindings.DownloadText(Name)}"
                                            Content="{x:Bind local:Bindings.DownloadText(Name)}"
                                            Click="OnFamilyDownloadClicked" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Canvas>
        </Popup>
    </Grid>
</Window>
