<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MyEverythingWidget.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MyEverythingWidget.App"
    xmlns:views="using:MyEverythingWidget.App.Views">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="V" Invoked="OnPasteInvoked" />
        </Grid.KeyboardAccelerators>

        <!-- Expanded widget. Row heights are fixed so the window can be sized to whole cells (MainWindow.Sizing). -->
        <Grid x:Name="ExpandedView">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <!-- Surface under the open tab; the tab strip stays on Mica. -->
            <Border Grid.Row="1"
                    Grid.RowSpan="3"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0" />

            <!-- One-row title bar: compact button, tabs, drag area, pin and close. -->
            <views:CategoryTabsView x:Name="TabsView" Grid.Row="0" Margin="4,0,4,0">
                <views:CategoryTabsView.LeadingContent>
                    <Button x:Name="CompactButton"
                            AutomationProperties.AutomationId="CompactButton"
                            AutomationProperties.Name="Compact mode"
                            ToolTipService.ToolTip="Shrink to an icon"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Margin="0,0,2,0"
                            Command="{x:Bind ViewModel.ToggleCompactCommand}">
                        <FontIcon FontSize="12" Glyph="&#xE73F;" />
                    </Button>
                </views:CategoryTabsView.LeadingContent>
                <views:CategoryTabsView.TrailingContent>
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <ToggleButton
                            x:Name="PinButton"
                            AutomationProperties.AutomationId="PinButton"
                            AutomationProperties.Name="Always on top"
                            ToolTipService.ToolTip="Always on top"
                            Style="{StaticResource TitleBarToggleButtonStyle}"
                            IsChecked="{x:Bind ViewModel.IsAlwaysOnTop, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ToggleAlwaysOnTopCommand}">
                            <FontIcon FontSize="14" Glyph="&#xE718;" />
                        </ToggleButton>
                        <Button
                            x:Name="CloseButton"
                            AutomationProperties.AutomationId="CloseButton"
                            AutomationProperties.Name="Close"
                            ToolTipService.ToolTip="Close"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="OnCloseClicked">
                            <FontIcon FontSize="12" Glyph="&#xE8BB;" />
                        </Button>
                    </StackPanel>
                </views:CategoryTabsView.TrailingContent>
            </views:CategoryTabsView>

            <views:WidgetGridView
                x:Name="GridView"
                Grid.Row="1"
                AllowDrop="True"
                DragOver="OnGridDragOver"
                Drop="OnGridDrop"
                Margin="6,6,6,6"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" />

            <!-- Bottom bar: add items, settings. -->
            <Grid Grid.Row="3" Padding="8,4,4,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DropDownButton x:Name="AddItemButton"
                                AutomationProperties.AutomationId="AddItemButton"
                                AutomationProperties.Name="Add">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="Add" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedLeft">
                            <MenuFlyoutItem x:Name="AddAppMenuItem"
                                            AutomationProperties.AutomationId="AddAppMenuItem"
                                            Text="App…"
                                            Click="OnAddAppClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xECAA;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="AddNoteMenuItem"
                                            AutomationProperties.AutomationId="AddNoteMenuItem"
                                            Text="Note"
                                            Click="OnAddNoteClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE70B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="AddImageMenuItem"
                                            AutomationProperties.AutomationId="AddImageMenuItem"
                                            Text="Image…"
                                            Click="OnAddImageClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEB9F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"
                           Text="Drop or paste (Ctrl+V) files, links, text or images" />
                <Button Grid.Column="2"
                        x:Name="SettingsButton"
                        AutomationProperties.AutomationId="SettingsButton"
                        AutomationProperties.Name="Settings"
                        ToolTipService.ToolTip="Settings"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Click="OnSettingsClicked">
                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                </Button>
            </Grid>

            <InfoBar
                x:Name="StatusBar"
                Grid.Row="2"
                Grid.RowSpan="2"
                Margin="8,0,8,8"
                VerticalAlignment="Bottom"
                AutomationProperties.AutomationId="StatusInfoBar"
                IsOpen="{x:Bind local:Bindings.HasText(Board.StatusMessage), Mode=OneWay}"
                Message="{x:Bind Board.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind local:Bindings.ToInfoBarSeverity(Board.StatusSeverity), Mode=OneWay}"
                CloseButtonCommand="{x:Bind Board.DismissStatusCommand}" />
        </Grid>

        <!-- Compact mode: the whole window is one icon. Click opens the widget; dragging moves the window. -->
        <Button x:Name="CompactIcon"
                AutomationProperties.AutomationId="CompactIcon"
                AutomationProperties.Name="Open My Everything Widget"
                ToolTipService.ToolTip="Open"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Padding="0"
                CornerRadius="0"
                BorderThickness="0"
                Background="{ThemeResource SubtleFillColorTransparentBrush}"
                Click="OnCompactIconClicked">
            <Image x:Name="CompactLogo" Width="48" Height="48" />
        </Button>
    </Grid>
</Window>
