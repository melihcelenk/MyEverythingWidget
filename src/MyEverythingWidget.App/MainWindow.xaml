<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MyEverythingWidget.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MyEverythingWidget.App"
    xmlns:views="using:MyEverythingWidget.App.Views">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="V" Invoked="OnPasteInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar: the drag region fills everything except the buttons on the right. -->
        <Grid x:Name="TitleBar" Grid.Row="0" Padding="12,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="TitleBarDragRegion" Grid.Column="0" Background="Transparent">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Title}" />
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <ToggleButton
                    x:Name="PinButton"
                    AutomationProperties.AutomationId="PinButton"
                    AutomationProperties.Name="Always on top"
                    ToolTipService.ToolTip="Always on top"
                    Style="{StaticResource TitleBarToggleButtonStyle}"
                    IsChecked="{x:Bind ViewModel.IsAlwaysOnTop, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ToggleAlwaysOnTopCommand}">
                    <FontIcon FontSize="14" Glyph="&#xE718;" />
                </ToggleButton>
                <Button
                    x:Name="CloseButton"
                    AutomationProperties.AutomationId="CloseButton"
                    AutomationProperties.Name="Close"
                    ToolTipService.ToolTip="Close"
                    Style="{StaticResource TitleBarButtonStyle}"
                    Click="OnCloseClicked">
                    <FontIcon FontSize="12" Glyph="&#xE8BB;" />
                </Button>
            </StackPanel>
        </Grid>

        <views:CategoryTabsView x:Name="TabsView" Grid.Row="1" Margin="4,0,4,0" />

        <!-- Surface under the open tab; the tab strip and title bar stay on Mica. -->
        <Border Grid.Row="2"
                Grid.RowSpan="3"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" />

        <views:WidgetGridView
            x:Name="GridView"
            Grid.Row="2"
            AllowDrop="True"
            DragOver="OnGridDragOver"
            Drop="OnGridDrop"
            Margin="6,6,6,6"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" />

        <!-- Bottom bar: add items. -->
        <Grid Grid.Row="4" Padding="8,0,8,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DropDownButton x:Name="AddItemButton"
                            AutomationProperties.AutomationId="AddItemButton"
                            AutomationProperties.Name="Add">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="Add" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedLeft">
                        <MenuFlyoutItem x:Name="AddAppMenuItem"
                                        AutomationProperties.AutomationId="AddAppMenuItem"
                                        Text="App…"
                                        Click="OnAddAppClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xECAA;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="AddNoteMenuItem"
                                        AutomationProperties.AutomationId="AddNoteMenuItem"
                                        Text="Note"
                                        Click="OnAddNoteClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE70B;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="AddImageMenuItem"
                                        AutomationProperties.AutomationId="AddImageMenuItem"
                                        Text="Image…"
                                        Click="OnAddImageClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEB9F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       TextTrimming="CharacterEllipsis"
                       Text="Drop or paste (Ctrl+V) files, links, text or images" />
        </Grid>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="3"
            Grid.RowSpan="2"
            Margin="8,0,8,8"
            VerticalAlignment="Bottom"
            AutomationProperties.AutomationId="StatusInfoBar"
            IsOpen="{x:Bind local:Bindings.HasText(Board.StatusMessage), Mode=OneWay}"
            Message="{x:Bind Board.StatusMessage, Mode=OneWay}"
            Severity="{x:Bind local:Bindings.ToInfoBarSeverity(Board.StatusSeverity), Mode=OneWay}"
            CloseButtonCommand="{x:Bind Board.DismissStatusCommand}" />
    </Grid>
</Window>
