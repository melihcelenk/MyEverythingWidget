<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MyEverythingWidget.App.Views.WidgetGridView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MyEverythingWidget.App.Views"
    AutomationProperties.AutomationId="WidgetGrid"
    IsTabStop="True"
    UseSystemFocusVisuals="False">

    <Canvas x:Name="CardLayer" Background="Transparent">
        <!-- Cells the dragged or resized item would cover; accent when allowed, red when not. -->
        <views:AutomationHost x:Name="DropPreview"
                              AutomationProperties.AutomationId="DropPreview"
                              AutomationProperties.Name="Drop target"
                              Visibility="Collapsed"
                              Canvas.ZIndex="0">
            <Border x:Name="DropPreviewBox"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    BorderThickness="2" />
        </views:AutomationHost>
    </Canvas>
</UserControl>
