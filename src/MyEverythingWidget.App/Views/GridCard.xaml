<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MyEverythingWidget.App.Views.GridCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="CardRoot"
          CornerRadius="{StaticResource OverlayCornerRadius}"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1">

        <!-- App: icon above a one-line label. -->
        <StackPanel x:Name="AppContent" Visibility="Collapsed" VerticalAlignment="Center" Spacing="4" Padding="4,0">
            <Grid Width="36" Height="36" HorizontalAlignment="Center">
                <Image x:Name="AppIcon" Stretch="Uniform" />
                <Border x:Name="AppMonogram"
                        CornerRadius="18"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock x:Name="AppMonogramText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                </Border>
            </Grid>
            <TextBlock x:Name="AppName"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>

        <!-- Note: wrapped text. -->
        <TextBlock x:Name="NoteText"
                   Visibility="Collapsed"
                   Margin="10,8"
                   TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis"
                   Style="{StaticResource BodyTextBlockStyle}" />

        <!-- Image: fills the card; the rounded corners of CardRoot clip it. -->
        <Image x:Name="ImageContent" Visibility="Collapsed" Stretch="UniformToFill" />
        <TextBlock x:Name="ImageMissing"
                   Visibility="Collapsed"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Text="Image not found" />

        <!-- Resize grip, shown while the pointer is over the card. -->
        <Border x:Name="ResizeHandle"
                AutomationProperties.AutomationId="ResizeHandle"
                AutomationProperties.Name="Resize"
                Width="18" Height="18"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="Transparent"
                Opacity="0">
            <Path Data="M 14,5 L 5,14 M 14,10 L 10,14"
                  Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
        </Border>
    </Grid>
</UserControl>
