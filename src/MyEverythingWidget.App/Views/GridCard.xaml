<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MyEverythingWidget.App.Views.GridCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="CardRoot"
          CornerRadius="{StaticResource OverlayCornerRadius}"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1">

        <!-- App: icon above a one-line label. -->
        <StackPanel x:Name="AppContent" Visibility="Collapsed" VerticalAlignment="Center" Spacing="4" Padding="4,0">
            <Grid Width="36" Height="36" HorizontalAlignment="Center">
                <Image x:Name="AppIcon" Stretch="Uniform" />
                <TextBlock x:Name="AppEmoji"
                           AutomationProperties.AutomationId="AppEmoji"
                           Visibility="Collapsed"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI Emoji"
                           FontSize="28"
                           IsTextScaleFactorEnabled="False" />
                <Border x:Name="AppMonogram"
                        CornerRadius="18"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock x:Name="AppMonogramText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                </Border>
            </Grid>
            <TextBlock x:Name="AppName"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>

        <!-- Note: wrapped text. -->
        <TextBlock x:Name="NoteText"
                   Visibility="Collapsed"
                   Margin="10,8"
                   TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis"
                   Style="{StaticResource BodyTextBlockStyle}" />

        <!-- Image: shown whole, centred; the card surface shows around it. -->
        <Image x:Name="ImageContent"
               AutomationProperties.AutomationId="ImageContent"
               Visibility="Collapsed"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />
        <TextBlock x:Name="ImageMissing"
                   Visibility="Collapsed"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Text="Image not found" />

        <!-- Copy button of notes, shown while the pointer is over the card. -->
        <Button x:Name="CopyNoteButton"
                AutomationProperties.AutomationId="CopyNoteButton"
                AutomationProperties.Name="Copy note"
                ToolTipService.ToolTip="Copy"
                Visibility="Collapsed"
                Opacity="0"
                Width="28" Height="28" Padding="0"
                Margin="0,3,3,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Style="{StaticResource TitleBarButtonStyle}"
                Click="OnCopyNoteClicked">
            <FontIcon FontSize="12" Glyph="&#xE8C8;" />
        </Button>

        <!-- Resize grip, shown while the pointer is over the card. -->
        <Border x:Name="ResizeHandle"
                AutomationProperties.AutomationId="ResizeHandle"
                AutomationProperties.Name="Resize"
                Width="18" Height="18"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="Transparent"
                Opacity="0">
            <Path Data="M 14,5 L 5,14 M 14,10 L 10,14"
                  Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
        </Border>
    </Grid>
</UserControl>
