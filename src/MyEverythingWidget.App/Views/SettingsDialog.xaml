<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MyEverythingWidget.App.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:MyEverythingWidget.App.Localization"
    xmlns:views="using:MyEverythingWidget.App.Views"
    AutomationProperties.AutomationId="SettingsDialog"
    AutomationProperties.Name="{l:Str Key=Settings}">

    <!-- A one-line header with a close cross instead of the dialog's title and Close button, so the settings start
         near the top. The dialog does not scroll its content itself; in a small widget the About section is below the
         fold. -->
    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="Header" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{l:Str Key=Settings}" />
            <Button x:Name="CloseCross"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="SettingsCloseButton"
                    AutomationProperties.Name="{l:Str Key=Close}"
                    ToolTipService.ToolTip="{l:Str Key=Close}"
                    Style="{StaticResource TitleBarButtonStyle}"
                    Click="OnCloseClicked">
                <FontIcon FontSize="12" Glyph="&#xE8BB;" />
            </Button>
        </Grid>
    <ScrollViewer x:Name="ContentScroller"
                  Grid.Row="1"
                  Margin="0,0,20,0"
                  AutomationProperties.AutomationId="SettingsScroller"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="252" Spacing="10">
        <StackPanel.Resources>
            <!-- One choice of a segmented control: one word, the chosen one filled with the accent colour. -->
            <Style x:Key="SegmentStyle" TargetType="RadioButton">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="Root" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Selection.Opacity" Value="1" />
                                                <Setter Target="Label.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Selection" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0" />
                                <ContentPresenter x:Name="Label"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
                <Setter Property="MinWidth" Value="0" />
            </Style>
        </StackPanel.Resources>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{l:Str Key=Language}" />
            <!-- Looks like a combo box, but its list opens downwards and ends at the bottom of the About card; WinUI's
                 ComboBox puts the chosen row over the box, so with the first row chosen its list grew upwards. -->
            <Button x:Name="LanguageChoice"
                    Grid.Column="1"
                    MinWidth="0"
                    Padding="11,5,8,6"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="LanguageChoice"
                    AutomationProperties.Name="{l:Str Key=Language}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LanguageText" AutomationProperties.AutomationId="LanguageText" TextTrimming="CharacterEllipsis" />
                    <FontIcon Grid.Column="1" FontSize="12" Glyph="&#xE70D;" />
                </Grid>
                <Button.Flyout>
                    <Flyout x:Name="LanguageFlyout" Placement="BottomEdgeAlignedLeft" Opening="OnLanguageListOpening" Opened="OnLanguageListOpened">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                                <Setter Property="Padding" Value="0,2" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="MaxHeight" Value="100000" />
                                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <ListView x:Name="LanguageList"
                                  AutomationProperties.AutomationId="LanguageList"
                                  AutomationProperties.Name="{l:Str Key=Language}"
                                  SelectionMode="Single"
                                  SelectionChanged="OnLanguagePicked">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                        </ListView>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{l:Str Key=Theme}" />
            <views:AutomationHost HorizontalAlignment="Left" AutomationProperties.AutomationId="ThemeChoices">
            <Border
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ThemeSystem" GroupName="Theme" Style="{StaticResource SegmentStyle}" AutomationProperties.AutomationId="ThemeSystem" Content="{l:Str Key=ThemeSystem}" ToolTipService.ToolTip="{l:Str Key=ThemeSystemTip}" Checked="OnThemeChecked" />
                    <RadioButton x:Name="ThemeLight" GroupName="Theme" Style="{StaticResource SegmentStyle}" AutomationProperties.AutomationId="ThemeLight" Content="{l:Str Key=ThemeLight}" Checked="OnThemeChecked" />
                    <RadioButton x:Name="ThemeDark" GroupName="Theme" Style="{StaticResource SegmentStyle}" AutomationProperties.AutomationId="ThemeDark" Content="{l:Str Key=ThemeDark}" Checked="OnThemeChecked" />
                </StackPanel>
            </Border>
            </views:AutomationHost>
        </StackPanel>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{l:Str Key=AlwaysOnTop}" />
            <ToggleSwitch x:Name="AlwaysOnTopSwitch"
                          Grid.Column="1"
                          AutomationProperties.AutomationId="AlwaysOnTopSwitch"
                          AutomationProperties.Name="{l:Str Key=AlwaysOnTop}"
                          OnContent=""
                          OffContent=""
                          Toggled="OnAlwaysOnTopToggled" />
        </Grid>

        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- TaskTimerWidget's About card: same colours, font sizes, emoji and link names. -->
        <views:AutomationHost AutomationProperties.AutomationId="AboutCard">
        <Border x:Name="AboutCard"
                Padding="14"
                Background="{ThemeResource AboutCardBackgroundBrush}"
                BorderBrush="{ThemeResource AboutCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel Spacing="4">
                <TextBlock x:Name="AppNameText"
                           AutomationProperties.AutomationId="AppNameText"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AboutCardTitleBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="VersionText" AutomationProperties.AutomationId="VersionText" FontSize="11" Foreground="{ThemeResource AboutCardTextBrush}" />
                <TextBlock FontSize="11" Foreground="{ThemeResource AboutCardTextBrush}" Text="2026" />
                <Border Height="1" Margin="0,2" Background="{ThemeResource AboutCardSeparatorBrush}" />
                <TextBlock FontSize="11" Foreground="{ThemeResource AboutCardTextBrush}" Text="Melih Çelenk" />
                <HyperlinkButton x:Name="EmailButton" AutomationProperties.AutomationId="AboutEmailButton" Padding="0" FontSize="11" Foreground="{ThemeResource AboutCardLinkBrush}" Click="OnEmailClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="EmailIcon" Text="&#x2709;" />
                        <TextBlock x:Name="EmailText" />
                    </StackPanel>
                </HyperlinkButton>
                <HyperlinkButton x:Name="PersonalLink" AutomationProperties.AutomationId="AboutPersonalLink" Padding="0" FontSize="11" Foreground="{ThemeResource AboutCardLinkBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#x1F464;" />
                        <TextBlock Text="melihcelenk.com" />
                    </StackPanel>
                </HyperlinkButton>
                <HyperlinkButton x:Name="WebsiteLink" AutomationProperties.AutomationId="AboutWebsiteLink" Padding="0" FontSize="11" Foreground="{ThemeResource AboutCardLinkBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#x1F310;" />
                        <TextBlock Text="{l:Str Key=Website}" />
                    </StackPanel>
                </HyperlinkButton>
                <HyperlinkButton x:Name="RateLink" AutomationProperties.AutomationId="AboutRateLink" Padding="0" FontSize="11" Foreground="{ThemeResource AboutCardLinkBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#x2B50;" />
                        <TextBlock Text="{l:Str Key=Rate}" />
                    </StackPanel>
                </HyperlinkButton>
            </StackPanel>
        </Border>
        </views:AutomationHost>
    </StackPanel>
    </ScrollViewer>
    </Grid>
</ContentDialog>
