<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MyEverythingWidget.App.Views.AddAppDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:apps="using:MyEverythingWidget.Core.Apps"
    xmlns:local="using:MyEverythingWidget.App"
    AutomationProperties.AutomationId="AddAppDialog"
    Title="Add app"
    PrimaryButtonText="Add"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanAdd, Mode=OneWay}"
    PrimaryButtonClick="OnAddClicked">

    <StackPanel MaxWidth="300" Spacing="8">
        <TextBox x:Name="SearchBox"
                 AutomationProperties.AutomationId="AppSearchBox"
                 AutomationProperties.Name="Search installed apps"
                 PlaceholderText="Search installed apps"
                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Grid Height="220">
            <ListView x:Name="AppList"
                      AutomationProperties.AutomationId="InstalledAppsList"
                      AutomationProperties.Name="Installed apps"
                      ItemsSource="{x:Bind ViewModel.FilteredApps}"
                      SelectionMode="Single"
                      SelectionChanged="OnAppSelectionChanged"
                      DoubleTapped="OnAppDoubleTapped">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="apps:InstalledApp">
                        <TextBlock Text="{x:Bind Name}"
                                   AutomationProperties.Name="{x:Bind Name}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        </Grid>

        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Or enter a path or web address" />
        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ManualBox"
                     AutomationProperties.AutomationId="ManualTargetBox"
                     AutomationProperties.Name="Path or web address"
                     PlaceholderText="C:\... or https://..."
                     Text="{x:Bind ViewModel.ManualText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1"
                    AutomationProperties.AutomationId="BrowseButton"
                    Content="Browse…"
                    Click="OnBrowseClicked" />
        </Grid>
        <TextBox x:Name="ManualNameBox"
                 AutomationProperties.AutomationId="ManualNameBox"
                 AutomationProperties.Name="Name"
                 Header="Name"
                 Visibility="{x:Bind local:Bindings.VisibleWhen(ViewModel.CanAddManual), Mode=OneWay}"
                 Text="{x:Bind ViewModel.ManualName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   TextWrapping="Wrap"
                   Text="{x:Bind ViewModel.ManualError, Mode=OneWay}" />
    </StackPanel>
</ContentDialog>
