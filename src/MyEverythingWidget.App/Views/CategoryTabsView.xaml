<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MyEverythingWidget.App.Views.CategoryTabsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:MyEverythingWidget.App.Localization">

    <TabView x:Name="Tabs"
             AutomationProperties.AutomationId="CategoryTabs"
             AutomationProperties.Name="{l:Str Key=Categories}"
             VerticalAlignment="Bottom"
             IsAddTabButtonVisible="False"
             CanReorderTabs="True"
             CanDragTabs="False"
             TabWidthMode="SizeToContent"
             SelectionChanged="OnSelectionChanged"
             TabItemsChanged="OnTabItemsChanged">
        <!-- The open tab joins the grid surface below it (same layer colour), as in Windows 11 tabbed apps.
             Theme dictionaries make the colour follow a theme change; a plain StaticResource would keep the start theme. -->
        <TabView.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="SolidBackgroundFillColorSecondaryBrush" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="SolidBackgroundFillColorSecondaryBrush" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="SystemColorWindowColorBrush" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </TabView.Resources>
        <TabView.TabStripHeader>
            <ContentPresenter x:Name="LeadingPresenter" VerticalAlignment="Center" />
        </TabView.TabStripHeader>
        <!-- The footer fills the rest of the strip: add button, the window drag area, then the window buttons. -->
        <TabView.TabStripFooter>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="AddCategoryButton"
                        AutomationProperties.AutomationId="AddCategoryButton"
                        AutomationProperties.Name="{l:Str Key=AddCategory}"
                        ToolTipService.ToolTip="{l:Str Key=AddCategory}"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Margin="2,0,0,0"
                        VerticalAlignment="Center"
                        Click="OnAddClicked">
                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                </Button>
                <Grid x:Name="DragArea" Grid.Column="1" MinWidth="12" Background="Transparent" />
                <ContentPresenter x:Name="TrailingPresenter" Grid.Column="2" VerticalAlignment="Center" />
            </Grid>
        </TabView.TabStripFooter>
    </TabView>
</UserControl>
