<?xml version="1.0" encoding="utf-8"?>
<!--
  Publisher uses the "unsigned package" OID so local and sandbox builds install with
  Add-AppxPackage -AllowUnsigned and need no certificate. The Store publisher identity from Partner Center
  replaces it when the app is associated with the Store (MEW-4 Faz 8).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 rescap">

  <Identity
    Name="MyEverythingWidget"
    Publisher="CN=MyEverythingWidget, OID.2.25.311729368913984317654407730594956997722=1"
    Version="0.1.0.0" />

  <Properties>
    <DisplayName>My Everything Widget</DisplayName>
    <PublisherDisplayName>Melih Çelenk</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="tr-TR" />
    <Resource Language="uk-UA" />
    <Resource Language="pl-PL" />
    <Resource Language="de-DE" />
    <Resource Language="es-ES" />
    <Resource Language="hi-IN" />
    <Resource Language="fil-PH" />
    <Resource Language="fr-FR" />
    <Resource Language="pt-BR" />
    <Resource Language="id-ID" />
    <Resource Language="it-IT" />
    <Resource Language="ru-RU" />
    <Resource Language="ko-KR" />
    <Resource Language="sv-SE" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="My Everything Widget"
        Description="Apps, notes and images in one small widget."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Widget family hub (MEW-5): finds the family widgets. Contract: external/WidgetFamily/docs/CONTRACT.md. -->
        <uap3:Extension Category="windows.appExtensionHost">
          <uap3:AppExtensionHost>
            <uap3:Name>com.melihcelenk.widgetfamily</uap3:Name>
          </uap3:AppExtensionHost>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
