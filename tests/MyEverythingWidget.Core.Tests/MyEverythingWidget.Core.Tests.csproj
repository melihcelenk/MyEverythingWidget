<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Grid scenarios (the specification) and the shared DSL reader. -->
  <ItemGroup>
    <Compile Include="..\Shared\GridDsl\*.cs" Link="GridDsl\%(Filename)%(Extension)" />
    <Content Include="..\Grid\*.dsl" Link="Grid\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MyEverythingWidget.Core\MyEverythingWidget.Core.csproj" />
  </ItemGroup>

</Project>
